# Conexión a MariaDB (el puerto 3308 coincide con compose.yaml; dbmate requiere el esquema mysql://)
DATABASE_URL=mysql://sigmas_user:sigmas_pass@localhost:3308/sigmas

# Puerto HTTP del backend
PORT=3000

# Orígenes permitidos para CORS, protección CSRF y authorizedParties de Clerk (separados por comas)
ORIGINS=http://localhost:5173

# Clave secreta del backend de Clerk (Dashboard -> API Keys)
CLERK_SECRET_KEY=sk_test_reemplaza_con_tu_clave

# Secreto de firma Svix del webhook de Clerk (Dashboard -> Webhooks -> Endpoint -> Signing Secret)
CLERK_WEBHOOK_SIGNING_SECRET=whsec_reemplaza_con_tu_secreto

# URL a la que Clerk redirige al usuario cuando acepta la invitación por correo
# Desarrollo: http://localhost:5173/user-register
# Producción: https://tu-dominio-frontend.edu.mx/user-register
CLERK_INVITATION_REDIRECT_URL=http://localhost:5173/user-register

# Transición temporal: permite que un administrador cuyo rol 'admin' solo existe en Clerk
# pueda operar mientras se registra su usuario y rol 'admin' en MariaDB.
# Desactivar (false) en cuanto los administradores estén dados de alta en MariaDB.
ADMIN_CLERK_METADATA_FALLBACK=false

